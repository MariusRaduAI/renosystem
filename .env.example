# Supabase (Projekt-Region eu-central-1 empfohlen, siehe supabase/schema.sql)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Lead-Benachrichtigung per E-Mail (resend.com — kostenloser Plan reicht).
# Ohne RESEND_API_KEY oder LEAD_NOTIFICATION_EMAIL wird bei einer neuen
# Anfrage keine E-Mail verschickt (der Lead landet dann nur in Supabase).
# RESEND_FROM_EMAIL muss eine in Resend verifizierte Domain nutzen, sonst
# bleibt der Resend-Test-Absender "onboarding@resend.dev" als Fallback aktiv.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
LEAD_NOTIFICATION_EMAIL=

# Analytics (optional, env-var-gated — ohne Werte bleibt Analytics deaktiviert)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_VERCEL_ANALYTICS=
